{
  "name": "glov-secure-mnemonic-shards",
  "version": "1.0.6",
  "description": "Professional mnemonic seed phrase splitting tool using Shamir Secret Sharing with file upload recovery, tab-based interface, and OpenPGP encryption support",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "vite preview --port 8080 --open",
    "dev": "vite",
    "serve": "vite preview --port 8080 --host",
    "build": "vite build",
    "test": "node tests/offline-regression.mjs",
    "test:offline": "node tests/offline-regression.mjs",
    "build:single": "npm run build && node tools/inline-build.mjs && node tools/hash.mjs && node tools/manifest.mjs",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [
    "mnemonic",
    "seed-phrase",
    "shamir",
    "secret-sharing",
    "cryptography",
    "backup",
    "wallet",
    "file-upload",
    "recovery",
    "tab-interface",
    "encryption",
    "openpgp",
    "offline",
    "client-side"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@scure/bip39": "^1.6.0",
    "openpgp": "^6.2.2",
    "qrcode": "^1.5.4",
    "shamir-secret-sharing": "^0.0.4",
    "slip39": "^0.1.9"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "terser": "^5.39.0",
    "vite": "^7.2.2",
    "vite-plugin-node-polyfills": "^0.26.0"
  }
}
